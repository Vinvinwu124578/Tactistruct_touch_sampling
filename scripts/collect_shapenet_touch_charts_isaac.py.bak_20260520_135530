"""Collect TouchSDF-style touch charts from ShapeNet meshes using Isaac rendering.

This script mirrors the data contract of TouchSDF's ``extract_touch_charts.py``:
each sample contains a tactile image and a GT local surface patch point cloud.
The tactile image is rendered by an Isaac Lab camera looking at a sampled mesh
surface contact, while the GT patch is computed directly from the ShapeNet mesh.
"""

from __future__ import annotations

import argparse
import csv
