_ORIGINAL_TILED_CAMERA_DEL = getattr(TiledCamera, "__del__", None)


def _safe_tiled_camera_del(self):
    if _ORIGINAL_TILED_CAMERA_DEL is None:
        return
    try:
        _ORIGINAL_TILED_CAMERA_DEL(self)
    except AttributeError as exc:
        if "_annotators" not in str(exc):
            raise


TiledCamera.__del__ = _safe_tiled_camera_del


